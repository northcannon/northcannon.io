---
import ReviewPage from '../../../../../src/components/WP4Review.astro';
import { readRoutes } from '../../../../../src/governance/routes.mjs';
export function getStaticPaths() {
  return readRoutes().filter(r => r.path !== '/404.html').map(route => ({ params: { route: route.path === '/' ? undefined : route.path.slice(1, -1) }, props: { route } }));
}
const { route } = Astro.props;
---
<ReviewPage route={route} />
