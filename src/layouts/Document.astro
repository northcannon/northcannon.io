---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Graphene from '../components/Graphene.astro';
interface Props { title: string; shell?: boolean }
const { title, shell = true } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/northcannon-mark.svg" />
  </head>
  <body>
    <Graphene />
    {shell && <SiteHeader showStatus />}
    <slot />
    {shell && <SiteFooter />}
  </body>
</html>
