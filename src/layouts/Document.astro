---
import '../styles/global.css';
import '../styles/pages.css';
import Graphene from '../components/Graphene.astro';
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/northcannon-mark.svg" />
  </head>
  <body>
    <Graphene />
    <slot />
  </body>
</html>
