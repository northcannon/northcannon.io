---
import f from '../../content/concept-scenario.json';
interface Props { t: (id: string) => string }
const { t } = Astro.props as Props;
---
<figure class="ci-graph"><figcaption>{t(f.labels.graph)}</figcaption><div class="ci-graph-scroll" role="region" tabindex="0" aria-label={t(f.labels['graph-access'])}><svg viewBox="0 0 820 790" xmlns="http://www.w3.org/2000/svg" aria-label={t(f.labels.graph)}><defs><marker id="ci-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" /></marker></defs>{f.edges.map(e => { const a = f.nodes.find(n => n.id === e.source)!; const b = f.nodes.find(n => n.id === e.target)!; const x = a.x + 210, y = a.y + 45; const end = b.y + 45; return <g class={`ci-edge ci-edge--${e.state}`} data-edge={e.id}><path d={`M ${x} ${y} H ${x+25} V ${end} H ${b.x-4}`} marker-end="url(#ci-arrow)" /><title>{t(e.label)}</title></g>; })}{f.nodes.map(n => <a href={`#ci-node-${n.id}`} class={`ci-node ${n.state}`} data-node={n.id} aria-label={t(n.label)}><rect x={n.x} y={n.y} width="210" height="90" rx="8"/><text class="ci-node-name" x={n.x+12} y={n.y+31}>{t(n.label)}</text><text class="ci-node-state" x={n.x+12} y={n.y+62}>{t(f.states[n.state as keyof typeof f.states])}</text></a>)}</svg></div><ul class="ci-legend">{Object.entries(f.states).map(([state,id]) => <li class={state}>{t(id)}</li>)}</ul><ul class="ci-edge-key">{f.edges.map(e => <li><span>{t(f.nodes.find(n => n.id === e.source)!.label)}</span><span>{t(e.label)}</span><span>{t(f.nodes.find(n => n.id === e.target)!.label)}</span></li>)}</ul></figure>
