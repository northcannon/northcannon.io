---
interface Props { text: (id: string) => string }
const { text } = Astro.props;
const tables = [
  { title: 'Evidence packets', columns: ['Packet', 'State', 'Content hash', 'Source'] },
  { title: 'Execution records', columns: ['Run', 'Arm', 'State', 'Provenance hash'] },
  { title: 'Artifact hashes', columns: ['Artifact', 'Content hash', 'Scope', 'Source'] },
];
---
<div class="evidence-register">
  <p class="panel evidence-notice">{text('status-gate1-preparation')}</p>
  <section class="panel evidence-block"><h2>Evidence generation</h2><dl class="generation-grid"><div><dt>Generation</dt><dd class="status-label">{text('label-preparation')}</dd></div><div><dt>Evidence store</dt><dd class="status-label">{text('label-null')}</dd></div></dl></section>
  <div class="evidence-cards">{tables.map(table => <section class="panel evidence-block"><span class="card-number" aria-hidden="true"></span><h2>{table.title}</h2><p>{text('label-null')}</p></section>)}</div>
  <section class="panel evidence-block evidence-ledger"><h2>{text('label-evidence')}</h2><div class="table-scroll" tabindex="0" role="region" aria-label={text('label-evidence')}><table><thead><tr>{['label-claim-id', 'label-basis', 'label-review-date', 'label-status'].map(id => <th scope="col">{text(id)}</th>)}</tr></thead><tbody><tr><td colspan="4">{text('label-null')}</td></tr></tbody></table></div></section>
  <div class="evidence-details"><section class="panel evidence-block"><h2>{text('label-provenance')}</h2><dl class="gate-fields">{['label-source-files', 'label-output-files'].map(id => <div><dt>{text(id)}</dt><dd>{text('label-null')}</dd></div>)}</dl></section><section class="panel evidence-block"><h2>Artifact hashes</h2><dl class="gate-fields"><div><dt>Artifact</dt><dd>{text('label-null')}</dd></div><div><dt>Content hash</dt><dd>{text('label-null')}</dd></div></dl></section></div>
</div>
