---
interface Props { steps: string[]; vertical?: boolean; current?: number }
const { steps, vertical = false, current } = Astro.props;
---
<ol class:list={['flow-steps', { 'flow-steps--vertical': vertical }]}>{steps.map((step, index) => <li aria-current={current === index ? 'step' : undefined}><span>{step}</span></li>)}</ol>
