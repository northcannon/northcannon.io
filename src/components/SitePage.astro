---
import Document from '../layouts/Document.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import HomePage from './pages/HomePage.astro';
import GatePage from './pages/GatePage.astro';
import ResultsPage from './pages/ResultsPage.astro';
import EvidencePage from './pages/EvidencePage.astro';
import AboutPage from './pages/AboutPage.astro';
import FounderPage from './pages/FounderPage.astro';
import AboutCompanyPage from './pages/AboutCompanyPage.astro';
import AboutFeaturesPage from './pages/AboutFeaturesPage.astro';
import ContactPage from './pages/ContactPage.astro';
import DemoPage from './pages/DemoPage.astro';
import SupportingPage from './pages/SupportingPage.astro';
import { loadGovernance } from '../governance/registry.mjs';
import { readRoutes, routeCopy, navigationTree, navigationClaimId, draftBanner } from '../governance/routes.mjs';
import type { Copy } from './copy';
interface Props { route: ReturnType<typeof readRoutes>[number]; review?: boolean }
const { route, review = true } = Astro.props;
const data = loadGovernance();
const routes = readRoutes(data.claims);
const t = (id: string): string | undefined => routeCopy(data.claims, route, routes, id, { review });
const available = new Set(routes.filter(r => review || r.publish).map(r => r.path));
const status = data.status[0]!;
const statusClaim = data.claims.find((c: { claim_id: string }) => c.claim_id === status.claim_id)!;
const stages: Record<string, number> = { preparation: 0, frozen: 1, executing: 5, complete: 6 };
const copy: Copy = {
  t,
  all: (...ids) => ids.every(id => t(id) !== undefined),
  paragraphs: id => t(id)?.split('\n\n') ?? [],
  href: path => (available.has(path) ? path : undefined),
  review,
  statusDate: statusClaim.review_date ?? '',
  stageIndex: stages[status.stage] ?? 0,
};
const company = t('brand-company')!;
const title = route.path === '/404.html' ? 'Page not found' : (t(route.title_claim_or_label) ?? company);
type Route = { path: string; title_claim_or_label: string };
const link = (r: Route) => ({ href: r.path, label: t(navigationClaimId(r))! });
const items = navigationTree(routes, { review, claims: data.claims }).map(({ route: top, children }: { route: Route; children: Route[] }) => ({ ...link(top), children: children.map(link) }));
// Preserve route dependency checks; the footer independently attests its fixed copy.
for (const id of ['brand-core-principle', 'label-trust', 'label-disclosure', 'label-contact']) t(id);
// Every page composition accepts the same shell props.
const pages = {
  '/': HomePage, '/gate-1/': GatePage, '/results/': ResultsPage, '/evidence/': EvidencePage,
  '/about/': AboutPage, '/about/company/': AboutCompanyPage, '/about/features/': AboutFeaturesPage, '/about/founder/': FounderPage, '/contact/': ContactPage, '/demo/': DemoPage,
} as unknown as Record<string, typeof SupportingPage>;
const Page = pages[route.path] ?? SupportingPage;
---
<Document title={title}>
  {review && <p class="draft-bar">{draftBanner}</p>}
  <SiteHeader review={review} company={company} items={items} currentPath={route.path} status={{ label: t('stage-frozen')!, gate: t('label-gate-1'), description: t('status-gate1-frozen-stress')!, href: copy.href('/gate-1/') ?? '/trust/status/' }} />
  <Page copy={copy} route={route} routes={routes} claims={data.claims} title={title} />
  <SiteFooter />
</Document>
