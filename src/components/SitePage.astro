---
import RedesignPage from './pages/RedesignPage.astro';
import draft from '../content/redesign.json';
import Document from '../layouts/Document.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import HomePage from './pages/HomePage.astro';
import GatePage from './pages/GatePage.astro';
import EvidencePage from './pages/EvidencePage.astro';
import FounderPage from './pages/FounderPage.astro';
import AboutCompanyPage from './pages/AboutCompanyPage.astro';
import AboutFeaturesPage from './pages/AboutFeaturesPage.astro';
import ContactPage from './pages/ContactPage.astro';
import DemoPage from './pages/DemoPage.astro';
import SupportingPage from './pages/SupportingPage.astro';
import { loadGovernance } from '../governance/registry.mjs';
import { readRoutes, routeCopy, navigationTree, draftBanner } from '../governance/routes.mjs';
import type { Copy } from './copy';
interface Props { route: ReturnType<typeof readRoutes>[number]; review?: boolean | undefined; conceptStyles?: string | undefined }
const { route, review = true, conceptStyles } = Astro.props;
const data = loadGovernance();
const routes = readRoutes(data.claims);
const t = (id: string): string | undefined => routeCopy(data.claims, route, routes, id, { review });
const available = new Set(routes.filter(r => review || r.publish).map(r => r.path));
const copy: Copy = {
  t,
  all: (...ids) => ids.every(id => t(id) !== undefined),
  paragraphs: id => t(id)?.split('\n\n') ?? [],
  href: path => (available.has(path.split('#')[0]!) ? path : undefined),
  review,
  status: entryId => data.status.find((entry: { entry_id: string; stage: string; claim_id: string }) => entry.entry_id === entryId),
};
const company = t('brand-company')!;
const title = route.path === '/404.html' ? 'Page not found' : (t(route.title_claim_or_label) ?? company);
type Item = { claimId: string; href: string; cta?: boolean | undefined; children?: Item[] };
type Nav = { href: string; label: string; cta?: boolean | undefined; children: Nav[] };
const link = (item: Item): Nav => ({ href: item.href, cta: item.cta, label: t(item.claimId)!, children: (item.children ?? []).map(link) });
const items = navigationTree(routes, { review, claims: data.claims }).map(link);
// Preserve route dependency checks; the footer independently attests its fixed copy.
for (const id of ['brand-core-principle', 'label-trust', 'label-disclosure', 'label-contact']) t(id);
// Every page composition accepts the same shell props.
const pages = {
  '/': HomePage, '/gate-1/': GatePage, '/evidence/': EvidencePage,
  '/about/company/': AboutCompanyPage, '/about/features/': AboutFeaturesPage, '/about/founder/': FounderPage, '/contact/': ContactPage, '/demo/': DemoPage,
} as unknown as Record<string, typeof SupportingPage>;
const Page = review && (route.alias_of ?? route.path) in draft.pages ? RedesignPage : (pages[route.path] ?? SupportingPage);
---
<Document conceptStyles={review ? conceptStyles : undefined} ogAlt={review ? t(draft.og_alt) : undefined} title={review && route.meta_title ? t(route.meta_title)! : title} description={review && route.meta_description ? t(route.meta_description) : undefined} canonical={review && route.path !== '/404.html' ? (route.alias_of ?? route.path) : undefined}>
  {review && <p class="draft-bar">{draftBanner}</p>}
  <SiteHeader review={review} company={company} items={items} currentPath={review ? (route.alias_of ?? route.path) : route.path} />
  <Page copy={copy} route={route} routes={routes} claims={data.claims} title={title} />
  <SiteFooter review={review} />
</Document>
