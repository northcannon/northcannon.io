---
import type { Copy } from '../copy';
interface Props { copy: Copy; [key: string]: unknown }
const { copy } = Astro.props;
const { t } = copy;
---
<main id="main" tabindex="-1" class="page-main">
  <div class="site-container page-stack">
    <h1 class="page-title">{t('label-gate-1')}</h1>
    {t('gate1-historical-statement') && <p class="lede">{t('gate1-historical-statement')}</p>}
  </div>
</main>
