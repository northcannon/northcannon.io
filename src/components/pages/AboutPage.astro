---
// About overview: the founder's text first, then modules for the company, why now, and the subpages.
import Module from '../Module.astro';
import LinkCard from '../LinkCard.astro';
import AboutSubnav from '../AboutSubnav.astro';
import type { Copy } from '../copy';
interface Props { copy: Copy; route: { path: string }; title: string; [key: string]: unknown }
const { copy, route, title } = Astro.props;
const { t, href } = copy;
const links = [
  { path: '/about/company/', title: 'label-company', body: 'about-link-company-body', icon: 'cube' },
  { path: '/about/features/', title: 'label-features', body: 'about-link-features-body', icon: 'layers' },
  { path: '/about/founder/', title: 'label-founder', body: 'about-link-founder-body', icon: 'users' },
].flatMap(link => (href(link.path) && t(link.title) ? [{ ...link, href: link.path }] : []));
---
<main id="main" tabindex="-1" class="page-main">
  <div class="site-container page-stack">
    <AboutSubnav copy={copy} currentPath={route.path} />
    <section class="page-hero page-hero--text" aria-labelledby="about-title">
      {t('about-eyebrow') && <p class="eyebrow">{t('about-eyebrow')}</p>}
      <h1 class="page-title" id="about-title">{t('about-headline') ?? title}</h1>
      <p class="lede">{t('brand-mission')}</p>
    </section>

    <div class="about-modules">
      <Module id="about-company" title={t('brand-company')!} numbered>
        <p class="prose-lead">{t('brand-company-motto')}</p>
      </Module>
      {t('about-why-title') && t('about-why-body') && (
        <Module id="about-why" title={t('about-why-title')!} numbered>
          <p class="prose-lead">{t('about-why-body')}</p>
        </Module>
      )}
    </div>

    {links.length > 0 && (
      <ul class="link-cards link-cards--triple">
        {links.map(link => <li><LinkCard href={link.href} icon={link.icon} title={t(link.title)!} text={t(link.body)} /></li>)}
      </ul>
    )}
  </div>
</main>
