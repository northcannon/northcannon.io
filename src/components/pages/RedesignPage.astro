---
import { productionManifestHash } from '../../governance/evidence.mjs';
import { validateEvidencePlacement } from '../../governance/evidence.mjs';
import LineageGraph from '../LineageGraph.astro';
import StateChip from '../StateChip.astro';
import Readout from '../Readout.astro';
import Verdict from '../Verdict.astro';
import SupportCells from '../SupportCells.astro';
import EvidenceDrawer from '../EvidenceDrawer.astro';
import draft from '../../content/redesign.json';
import PageHero from '../PageHero.astro';
import Section from '../Section.astro';
import OfferingCard from '../OfferingCard.astro';
import ControlLoop from '../ControlLoop.astro';
import ControlStack from '../ControlStack.astro';
import Distinction from '../Distinction.astro';
import FlowSteps from '../FlowSteps.astro';
import StatusTriad from '../StatusTriad.astro';
import FounderProfile from '../FounderProfile.astro';
import DataTable from '../DataTable.astro';
import type { Copy } from '../copy';
interface SectionData { id: string; title: string; body?: string | undefined; items?: string[]; kind?: string | undefined; status?: string | undefined; subtitle?: string | undefined; rows?: string[][]; transition?: string | undefined; cta?: string | undefined; secondary?: string | undefined; qualifiers?: string[]; topology?: boolean; stages?: string[][]; categories?: [string, number[]][]; status_row?: string[] }
interface PageData { key: string; title: string; lede: string; eyebrow: string; sections: SectionData[] }
interface Props { copy: Copy; route: { path: string; alias_of?: string | undefined } }
const { copy, route } = Astro.props;
const t = (id: string) => { const value = copy.t(id); if (value === undefined) throw new Error(`Missing redesign claim: ${id}`); return value; };
const pages = draft.pages as Record<string, PageData>;
const page = pages[route.alias_of ?? route.path]!;
const instrument = ['evidence', 'experiments', 'status'].includes(page.key);
const columns = draft.triad.map(col => ({ label: t(col.label), items: col.items.map(t) }));
const stageLabels = draft.loop.map(([label]) => t(label!));
const stages = page.key !== 'home' ? [] : draft.loop.map(([label, question], index) => ({ label: t(label!), question: t(question!), state: draft.loop_states[index] === 'implemented' ? { label: t('redesign-label-phase-a'), tone: 'implemented' as const } : { label: t(draft.labels.planned), tone: 'planned' as const } }));
const words = (section: SectionData) => (section.items ?? []).map(t);
const manifestHash = page.key === 'evidence' ? productionManifestHash() : '';
validateEvidencePlacement(draft.historical, 'ledger');
const statusTone: Record<string, 'planned' | 'illustrative' | 'future' | 'inactive' | 'neutral'> = { [draft.labels.planned]: 'planned', [draft.labels.knowledge]: 'illustrative', [draft.labels.target]: 'planned', [draft.labels.expansion]: 'inactive', [draft.labels.concept]: 'future' };
const flowColumns: Record<string, 2 | 3 | 4 | 5 | 6> = { 'customer-zero': 5, workflow: 4, 'research-to-product': 6 };
const special = new Set(['research','usecases','scope','panel','compare','distinction','loop','triad','deployment','topology','stack','lineage','founder','packet','intents','gate','ledger','historical','methodology','results','security','availability','agnostic','contact']);
---
<main id="main" tabindex="-1" class:list={['redesign-main', instrument ? 'instrument-zone' : 'product-zone']}>
<div class="site-container">
  <PageHero title={t(page.title)} eyebrow={t(page.eyebrow)} lede={t(page.lede)} instrument={instrument}>
    <div slot="actions" class="action-group">
      {['home','demo'].includes(page.key) && <a class="action-link action-link--primary" href="/products/">{t(draft.shared.explore)}</a>}
      {page.key === 'home' && <a class="action-link action-link--secondary" href="/evidence/">{t(draft.shared.evidence)}</a>}
      {page.key === 'products' && <a class="action-link action-link--primary" href="/contact/">{t('cta-get-in-touch')}</a>}
      {page.key === 'solutions' && <a class="action-link action-link--primary" href="/contact/">{t('cta-get-in-touch')}</a>}
    </div>
    {page.key === 'home' && <aside class="hero-aside"><p class="eyebrow">{t(draft.shared.descriptor)}</p><p class="hero-aside__statement">{t(draft.shared.receipt)}</p><div class="chip-row"><StateChip label={t(draft.example.design)} tone="planned" /></div></aside>}
  </PageHero>
  {instrument && <p class="state-label">{t(draft.labels.reconciled)}</p>}
  {page.sections.map(section => <Section id={section.id} cta={section.kind === 'contact'} secondary={Boolean((section as { secondary?: unknown }).secondary) && section.kind === 'historical'} title={t(section.title)} intro={section.body && !['future', 'panel', 'kpis', 'results', 'methodology'].includes(section.kind ?? '') ? t(section.body) : undefined} instrument={instrument}>
    {section.status && <p class="chip-row"><StateChip label={t(section.status)} tone={statusTone[section.status] ?? 'neutral'} /></p>}
    {section.kind === 'compare' && (() => { const w = words(section); return <div class="compare"><div class="compare__panel"><h3>{w[0]}</h3><ul>{w.slice(2,5).map(text => <li>{text}</li>)}</ul></div><span class="compare__marker"><span aria-hidden="true">≠</span><span class="visually-hidden">{t(draft.labels['is-not'])}</span></span><div class="compare__panel compare__panel--control"><h3>{w[1]}</h3><ul><li>{w[5]}</li></ul></div></div>; })()}
    {section.kind === 'distinction' && <><Distinction statements={words(section).slice(0,2)} alternative={t(draft.labels['is-not'])} /><ul class="editorial-list">{words(section).slice(2).map(text => <li>{text}</li>)}</ul></>}
    {section.kind === 'loop' && (page.key === 'home' ? <><ControlLoop stages={stages} recovery={t(draft.shared.recovery)} /><div class="group-qualifier"><p>{t(draft.shared['recovery-distinct'])}</p></div></> : <FlowSteps steps={stageLabels} grid={6} />)}
    {section.kind === 'triad' && <><StatusTriad columns={columns} /><div class="group-qualifier"><p>{t(draft.shared.qualification)}</p>{page.key !== 'evidence' && <a class="inline-link" href="/evidence/#status">{t(draft.shared.evidence)}</a>}</div></>}
    {section.kind === 'scope' && <div class="scope-columns">{[[0,'implemented',t('redesign-label-phase-a')],[1,'planned',t(draft.labels.planned)]].map(([index,tone,label]) => <div class="card"><p class="chip-row"><StateChip label={label as string} tone={tone as 'implemented' | 'planned'} /></p><ul>{draft.triad[index as number]!.items.map(id => <li>{t(id)}</li>)}</ul></div>)}</div>}
    {section.kind === 'panel' && section.body && <div class="panel-note"><p>{t(section.body)}</p></div>}
    {section.kind === 'deployment' && <><div class="offering-grid">{draft.deployments.map((card, index) => <OfferingCard title={t(card.title)} body={t(card.body)} status={t(draft.labels.planned)}>{section.topology && <div class="topology-boundary"><p class="state-label">{t(index === 0 ? draft.example['northcannon-environment'] : draft.example['your-environment'])}</p><p>{t('brand-company')}</p></div>}</OfferingCard>)}</div><div class="group-qualifier"><p>{t(draft.shared.availability)}</p>{(section.qualifiers ?? []).map(id => <p>{t(id)}</p>)}</div></>}
    {section.kind === 'stack' && <ControlStack layers={words(section)} />}
    {section.kind === 'lineage' && <><div class="lineage-layout"><div><LineageGraph id="engineering-lineage" large alt={t(draft.shared.illustration)} columns={words(section).slice(0,3) as [string,string,string]} nodes={[{id:"dependency",col:0,row:1,affected:true},{id:"service",col:1,row:0,affected:true},{id:"test",col:1,row:1,affected:true},{id:"docs",col:1,row:2,affected:false},{id:"build",col:2,row:0,affected:true},{id:"artifact",col:2,row:1,affected:true},{id:"other",col:2,row:2,affected:false}]} edges={[["dependency","service"],["dependency","test"],["service","build"],["test","artifact"],["test","build"],["docs","other"]]} /></div><div class="consequence"><div class="chip-row"><StateChip label={t(draft.labels.knowledge)} tone="illustrative" /></div><ol class="consequence__list">{words(section).slice(3).map(text => <li>{text}</li>)}</ol><a class="inline-link" href="/solutions/#knowledge-blast-radius">{t(draft.shared['knowledge-teaser'])}</a></div></div></>}
    {section.kind === 'usecases' && <div class="grid grid--3">{words(section).map((text, index) => <p class="use-case" data-index={String(index + 1).padStart(2, '0')}>{text}</p>)}</div>}
    {section.kind === 'flow' && <><FlowSteps steps={words(section)} grid={flowColumns[section.id]} vertical={!flowColumns[section.id]} />{page.key === 'solutions' && <div class="worked-example"><p class="state-label">{t(draft.shared.illustration)}</p><div class="worked-example__summary"><div class="worked-example__facts"><Readout label={t(draft.example.intent)} value={t(draft.example.dependency)} /><Verdict tone="reeval">{t(draft.example.verdict)}</Verdict></div><SupportCells label={t(draft.example.record)} cells={['intent','impact','authority','scope','observation'].map(key => ({label:t(draft.example[key as keyof typeof draft.example]),state:'supported',stateLabel:t(draft.labels.illustrative)}))} /></div><EvidenceDrawer id="illustrative-record" title={t(draft.example.record)} rows={[{label:t(draft.example.observation),value:t(draft.example['record-body'])}]} /></div>}</>}
    {section.kind === 'milestones' && <ol class="stage-grid stage-grid--fill">{(section.stages ?? []).map(([name, state]) => <li><span>{t(name!)}</span><StateChip label={t(state === 'implemented' ? 'redesign-milestone-state-implemented' : state === 'next' ? draft.labels.next : draft.labels.target)} tone={state === 'implemented' ? 'implemented' : state === 'next' ? 'planned' : 'neutral'} /></li>)}</ol>}
    {section.kind === 'packet' && <><div class="group-qualifier"><p>{t(draft.shared['knowledge-disclosure'])}</p></div><FlowSteps steps={[t(draft.example.dependency),t('label-change-intelligence')]} grid={2} /><div class="knowledge-branches"><div><p>{t(draft.example.runtime)}</p></div><div><p>{t(draft.example.knowledge)}</p><ul class="tag-list">{draft.packet.map(([surface]) => <li>{t(surface!)}</li>)}</ul></div></div><p>{t(draft.example.obligations)}</p><DataTable caption={t(section.title)} columns={[t(draft.labels.obligation),t(draft.labels.surface),t(draft.labels.reason)]} rows={words(section).map((text,i) => [text,t(draft.packet[i]![0]!),t(draft.packet[i]![1]!)])} /></>}
    {section.kind === 'cards' && <div class={`grid grid--${Math.min(4, (section.items ?? []).length)}`}>{words(section).map(text => <OfferingCard body={text} variant="muted" />)}</div>}
    {section.kind === 'future' && <OfferingCard title={t(section.subtitle!)} status={t(draft.labels.concept)} tone="future" variant="future"><p>{t(section.body!)}</p><FlowSteps steps={words(section)} grid={4} /><a class="inline-link" href="/contact/">{t('label-contact')}</a></OfferingCard>}
    {section.kind === 'company' && <><div class="editorial-rows">{(section.rows ?? []).map(([label, body]) => <p class="editorial-rows__row"><span class="editorial-rows__label">{t(label!)}</span><span class="editorial-rows__body">{t(body!)}</span></p>)}</div><div class="principles"><blockquote>{t('brand-company-motto')}</blockquote><p>{t('brand-core-principle')}</p></div></>}
    {section.kind === 'founder' && <FounderProfile name={t('founder-origin-attribution')} alt={t('founder-photo-alt')} bio={t('about-founder-bio')} quote={t('founder-origin-quote')} note={t('founder-origin-note')} transition={section.transition ? t(section.transition) : undefined} />}
    {section.kind === 'kpis' && <div data-evidence-class="product"><div class="group-qualifier"><StateChip label={t(draft.classes.product)} tone="neutral" /><p>{t(section.body!)}</p></div><div class="grid grid--2 grid--start">{(section.categories ?? []).map(([category, numbers]) => <div class="card metric-category"><h3>{t(category)}</h3>{numbers.map(number => <details class="metric"><summary><span class="metric__name">{t(draft.kpi_terms[`redesign-evidence-kpis-${number}` as keyof typeof draft.kpi_terms])}</span><span class="metric__line">{t(`redesign-kpi-line-${number}`)}</span></summary><p>{t(`redesign-evidence-kpis-${number}`)}</p></details>)}</div>)}</div></div>}
    {section.kind === 'gate' && <><div class="group-qualifier"><p>{t('status-gate1-discontinued')}</p></div><ol class="stage-grid stage-grid--7">{['stage-defined','stage-frozen','stage-independent-review','stage-stress-test','stage-authorized','stage-executing','stage-results-published'].map((id, index) => <li><span>{t(id)}</span><StateChip label={t(index < 2 ? 'redesign-ledger-reached' : draft.labels['not-reached'])} tone={index < 2 ? 'reached' : 'inactive'} /></li>)}</ol><div class="chip-row"><span class="state-label">{t('redesign-experiments-arms-label')}</span>{draft.arms.map(id => <StateChip label={t(id)} tone="neutral" />)}</div></>}
    {section.kind === 'research' && <dl class="research-grid">{(section.rows ?? []).map(([label, body]) => <div><dt>{t(label!)}</dt><dd>{t(body!)}</dd></div>)}<div class="research-grid__status"><dt>{t(section.status_row![0]!)}</dt><dd>{t(section.status_row![1]!)}</dd></div></dl>}
    {section.kind === 'ledger' && <div class="evidence-ledger">{(() => { const records = [
      {evidence_class:'artifact',subject:t(draft.artifact_subject),status:t(draft.labels['site-only']),date:undefined,sha256:manifestHash,type:t(draft.labels.manifest),identity:'site',href:'/provenance.json',link:t('label-provenance')},
      {evidence_class:'research',subject:t(draft.labels.experiments),status:t(draft.labels['no-results']),date:t(draft.labels['research-date']),sha256:undefined,type:t(draft.labels.statement),identity:undefined,href:'/experiments/#gate-1',link:t(draft.labels.experiments)},
      {evidence_class:'historical',subject:t(draft.historical.subject),status:t(draft.labels.historical),date:draft.historical.date,sha256:draft.historical.sha256,type:t(draft.labels.recording),identity:'historical',href:undefined,link:undefined}
    ]; for (const record of records) validateEvidencePlacement({evidence_class:record.evidence_class,subject:record.subject,status:record.status,...(record.date ? {date:record.date}:{}),...(record.sha256 ? {sha256:record.sha256}:{})},'ledger');
    return <DataTable caption={t(section.title)} columns={[t(draft.labels.date),t(draft.labels.class),t(draft.labels.subject),t(draft.labels.type),t(draft.labels.hash),t('label-status'),t(draft.labels.link)]} rows={[['—',t(draft.classes.product),t(draft.labels['product-empty']),'—','—','—','—'],...records.map(record => [record.date ?? '—',t(draft.classes[record.evidence_class as keyof typeof draft.classes]),record.subject,record.type,{text:record.sha256 ?? '—',hash:record.sha256 ? record.identity : undefined},record.status,{text:record.link ?? '—',href:record.href}])]} />; })()}<a class="inline-link" href="/trust/claims/">{t('ledger-browse')}</a></div>}
    {section.kind === 'historical' && <p class="state-label" data-evidence-class="historical">{t(draft.classes.historical)}</p>}
    {section.kind === 'methodology' && <div class="compact-close"><div class="compact-close__text"><p>{t(section.body!)}</p><p>{t('methodology-evidence')}</p></div><div class="action-group">{[['label-claims','/trust/claims/'],['label-provenance','/trust/provenance/'],['label-changelog','/trust/changelog/']].map(([label,href]) => <a class="inline-link" href={href}>{t(label!)}</a>)}</div></div>}
    {section.kind === 'results' && <div class="compact-close"><p class="compact-close__text">{t(section.body!)}</p><a class="inline-link" href={page.key === 'evidence' ? '/experiments/' : '/evidence/#experimental-results'}>{t(page.key === 'evidence' ? draft.labels.experiments : 'label-evidence')}</a></div>}
    {section.kind === 'availability' && <div class="group-qualifier"><p>{t(draft.shared.availability)}</p><a class="inline-link" href="/evidence/#status">{t(draft.shared.evidence)}</a></div>}
    {section.kind === 'agnostic' && <><p class="state-label">{t('interop-agnostic-label')}</p><div class="grid grid--3">{['interop-agnostic-model','interop-agnostic-agent','interop-agnostic-cloud'].map(id => <div class="card"><h3>{t(id)}</h3></div>)}</div></>}
    {section.kind === 'intents' && <><ul class="editorial-list">{words(section).map(subject => <li><a class="inline-link" href={`mailto:${t('contact-hello')}?subject=${encodeURIComponent(subject)}`}>{subject}</a></li>)}</ul><p>{t('disclosure-report')}</p><a class="inline-link" href={`mailto:${t('contact-security')}`}>{t('contact-security')}</a></>}
    {section.kind === 'security' && <a class="inline-link" href="/trust/site-security/">{t('label-site-security')}</a>}
    {section.kind === 'contact' && <div class="action-group"><a class="action-link action-link--primary" href="/contact/">{t(section.cta ?? 'cta-get-in-touch')}</a>{section.secondary && <a class="action-link action-link--secondary" href="/products/">{t(section.secondary)}</a>}</div>}
    {!special.has(section.kind ?? '') && !['flow','milestones','cards','future','company','kpis'].includes(section.kind ?? '') && section.items && <ul class="editorial-list">{words(section).map(text => <li>{text}</li>)}</ul>}
  </Section>)}
</div></main>
