---
import { productionManifestHash } from '../../governance/evidence.mjs';
import { validateEvidencePlacement } from '../../governance/evidence.mjs';
import LineageGraph from '../LineageGraph.astro';
import Readout from '../Readout.astro';
import Verdict from '../Verdict.astro';
import SupportCells from '../SupportCells.astro';
import EvidenceDrawer from '../EvidenceDrawer.astro';
import draft from '../../content/redesign.json';
import PageHero from '../PageHero.astro';
import Section from '../Section.astro';
import OfferingCard from '../OfferingCard.astro';
import ControlLoop from '../ControlLoop.astro';
import ControlStack from '../ControlStack.astro';
import Distinction from '../Distinction.astro';
import FlowSteps from '../FlowSteps.astro';
import StatusTriad from '../StatusTriad.astro';
import LifecycleStepper from '../LifecycleStepper.astro';
import FounderProfile from '../FounderProfile.astro';
import DataTable from '../DataTable.astro';
import type { Copy } from '../copy';
interface SectionData { id: string; title: string; body?: string | undefined; items?: string[]; kind?: string | undefined; status?: string | undefined; subtitle?: string | undefined }
interface PageData { key: string; title: string; lede: string; eyebrow: string; sections: SectionData[] }
interface Props { copy: Copy; route: { path: string; alias_of?: string | undefined } }
const { copy, route } = Astro.props;
const t = (id: string) => { const value = copy.t(id); if (value === undefined) throw new Error(`Missing redesign claim: ${id}`); return value; };
const pages = draft.pages as Record<string, PageData>;
const page = pages[route.alias_of ?? route.path]!;
const instrument = ['evidence', 'experiments', 'status'].includes(page.key);
const columns = draft.triad.map(col => ({ label: t(col.label), items: col.items.map(t) }));
const stages = draft.loop.map(([label, question]) => ({ label: t(label!), question: t(question!) }));
const words = (section: SectionData) => (section.items ?? []).map(t);
const manifestHash = page.key === 'evidence' ? productionManifestHash() : '';
validateEvidencePlacement(draft.historical, 'ledger');
const special = new Set(['distinction','loop','triad','deployment','topology','stack','lineage','founder','packet','intents','gate','ledger','historical','methodology','results','security','availability','agnostic','contact']);
---
<main id="main" tabindex="-1" class:list={['redesign-main', instrument ? 'instrument-zone' : 'product-zone']}>
<div class="site-container">
  <PageHero title={t(page.title)} eyebrow={t(page.eyebrow)} lede={t(page.lede)} instrument={instrument}>
    <div slot="actions" class="action-group">
      {['home','demo'].includes(page.key) && <a class="action-link action-link--primary" href="/products/">{t(draft.shared.explore)}</a>}
      {page.key === 'home' && <a class="action-link action-link--secondary" href="/evidence/">{t(draft.shared.evidence)}</a>}
      {page.key === 'products' && <a class="action-link action-link--primary" href="/contact/">{t(draft.shared.pricing)}</a>}
      {page.key === 'solutions' && <a class="action-link action-link--primary" href="/contact/">{t(draft.shared.partner)}</a>}
    </div>
    {page.key === 'home' && <div><p class="eyebrow">{t(draft.shared.descriptor)}</p><p class="state-label">{t(draft.example.design)}</p><ControlLoop stages={stages} recovery={t(draft.shared.receipt)} compact /></div>}
  </PageHero>
  {instrument && <p class="state-label">{t(draft.labels.reconciled)}</p>}
  {page.sections.map(section => <Section id={section.id} title={t(section.title)} intro={section.body && section.kind !== 'future' ? t(section.body) : undefined} instrument={instrument}>
    {section.status && <p class="state-label"><span aria-hidden="true">◇</span><span>{t(section.status)}</span></p>}
    {section.kind === 'distinction' && <><Distinction statements={words(section).slice(0,2)} alternative={t(draft.labels['is-not'])} /><ul class="editorial-list">{words(section).slice(2).map(text => <li>{text}</li>)}</ul></>}
    {section.kind === 'loop' && <><ControlLoop stages={stages} recovery={t(draft.shared.recovery)} /><p class="section-lede">{t(draft.shared['recovery-distinct'])}</p></>}
    {section.kind === 'triad' && <><StatusTriad columns={columns} /><p class="section-lede">{t(draft.shared.qualification)}</p>{page.key !== 'evidence' && <a class="inline-link" href="/evidence/#status">{t(draft.shared.evidence)}</a>}</>}
    {['deployment','topology'].includes(section.kind ?? '') && <><div class="offering-grid">{draft.deployments.map(card => <OfferingCard title={t(card.title)} body={section.kind === 'deployment' ? t(card.body) : undefined} status={t(draft.labels.planned)}><div class="topology-boundary"><p class="state-label">{t(card === draft.deployments[0] ? draft.example['northcannon-environment'] : draft.example['your-environment'])}</p><p>{t('brand-company')}</p></div></OfferingCard>)}</div><p class="section-lede">{t(draft.shared.availability)}</p></>}
    {section.kind === 'stack' && <ControlStack layers={words(section)} />}
    {section.kind === 'lineage' && <><LineageGraph id="engineering-lineage" alt={t(draft.shared.illustration)} columns={words(section).slice(0,3) as [string,string,string]} nodes={[{id:"dependency",col:0,row:2,affected:true},{id:"service",col:1,row:1,affected:true},{id:"test",col:1,row:3,affected:true},{id:"build",col:2,row:2,affected:true}]} edges={[["dependency","service"],["dependency","test"],["service","build"],["test","build"]]} /><ul class="editorial-list">{words(section).slice(3).map(text => <li>{text}</li>)}</ul><p class="state-label">{t(draft.shared.illustration)}</p><a class="inline-link" href="/solutions/#knowledge-blast-radius">{t(draft.shared['knowledge-teaser'])}</a></>}
    {section.kind === 'flow' && <><FlowSteps steps={words(section)} vertical={page.key !== 'home'} />{page.key === 'solutions' && <div class="worked-example"><p class="state-label">{t(draft.shared.illustration)}</p><Readout label={t(draft.example.intent)} value={t(draft.example.dependency)} /><Verdict tone="reeval">{t(draft.example.verdict)}</Verdict><SupportCells label={t(draft.example.record)} cells={['intent','impact','authority','scope','observation'].map(key => ({label:t(draft.example[key as keyof typeof draft.example]),state:'supported',stateLabel:t(draft.labels.illustrative)}))} /><EvidenceDrawer id="illustrative-record" title={t(draft.example.record)} rows={[{label:t(draft.example.observation),value:t(draft.example['record-body'])}]} /></div>}</>}
    {section.kind === 'milestones' && <LifecycleStepper steps={words(section)} current={1} />}
    {section.kind === 'packet' && <><p class="state-label">{t(draft.shared['knowledge-disclosure'])}</p><FlowSteps steps={[t(draft.example.dependency),t('label-change-intelligence')]} /><div class="knowledge-branches"><ul><li>{t(draft.example.runtime)}</li></ul><ul><li>{t(draft.example.knowledge)}</li></ul></div><p>{t(draft.example.obligations)}</p><DataTable caption={t(section.title)} columns={[t(draft.labels.obligation),t(draft.labels.surface),t(draft.labels.reason),t('label-status')]} rows={words(section).map((text,i) => [text,t(draft.packet[i]![0]!),t(draft.packet[i]![1]!),t(draft.labels.illustrative)])} /></>}
    {section.kind === 'cards' && <div class="offering-grid">{words(section).map(text => <OfferingCard body={text} variant="muted" />)}</div>}
    {section.kind === 'future' && <OfferingCard title={t(section.subtitle!)} status={t(draft.labels.concept)} variant="future"><p>{t(section.body!)}</p><FlowSteps steps={words(section)} /><a class="inline-link" href="/contact/">{t('label-contact')}</a></OfferingCard>}
    {section.kind === 'company' && <><ul class="editorial-list">{words(section).map(text => <li>{text}</li>)}</ul><blockquote>{t('brand-company-motto')}</blockquote><p>{t('brand-core-principle')}</p><a class="inline-link" href="/products/">{t(draft.shared.explore)}</a></>}
    {section.kind === 'founder' && <><FounderProfile name={t('founder-origin-attribution')} alt={t('founder-photo-alt')} bio={t('about-founder-bio')} quote={t('founder-origin-quote')} note={t('founder-origin-note')} /><a class="inline-link" href="/contact/">{t('label-contact')}</a></>}
    {section.kind === 'kpis' && <div data-evidence-class="product"><p class="state-label">{t(draft.classes.product)}</p><dl class="kpi-definitions">{(section.items ?? []).map(id => <div><dt>{t(draft.kpi_terms[id as keyof typeof draft.kpi_terms])}</dt><dd>{t(id)}</dd></div>)}</dl></div>}
    {section.kind === 'gate' && <><p>{t('status-gate1-discontinued')}</p><ol class="flow-steps flow-steps--vertical">{['stage-defined','stage-frozen'].map(id => <li><span>{t(id)}</span><span>{t(draft.labels.reached)}</span></li>)}</ol><ul class="editorial-list">{draft.arms.map(id => <li>{t(id)}</li>)}</ul><ul class="editorial-list">{['stage-independent-review','stage-stress-test','stage-authorized','stage-executing','stage-results-published'].map(id => <li><span>{t(id)}</span> — <span>{t(draft.labels['not-reached'])}</span></li>)}</ul></>}
    {section.kind === 'ledger' && <div class="evidence-ledger"><div data-evidence-class="product"><h3>{t(draft.classes.product)}</h3><p>{t(draft.labels['product-empty'])}</p></div>{[
      {evidence_class:'artifact',subject:t(draft.artifact_subject),status:t(draft.labels['site-only']),date:undefined,sha256:manifestHash,type:t(draft.labels.manifest),identity:'site',href:'/provenance.json',link:t('label-provenance')},
      {evidence_class:'research',subject:t('status-gate1-discontinued'),status:t(draft.labels['no-results']),date:t(draft.labels['research-date']),sha256:undefined,type:t(draft.labels.statement),identity:undefined,href:'/experiments/#gate-1',link:t(draft.labels.experiments)},
      {evidence_class:'historical',subject:t(draft.historical.subject),status:t(draft.labels.historical),date:draft.historical.date,sha256:draft.historical.sha256,type:t(draft.labels.recording),identity:'historical',href:undefined,link:undefined}
    ].map(record => { validateEvidencePlacement({evidence_class:record.evidence_class,subject:record.subject,status:record.status,...(record.date ? {date:record.date}:{}),...(record.sha256 ? {sha256:record.sha256}:{})},'ledger');return <article data-evidence-class={record.evidence_class}><DataTable caption={t(draft.classes[record.evidence_class as keyof typeof draft.classes])} columns={[t(draft.labels.date),t(draft.labels.class),t(draft.labels.subject),t(draft.labels.type),t(draft.labels.hash),t('label-status'),t(draft.labels.link)]} rows={[[record.date ?? '—',t(draft.classes[record.evidence_class as keyof typeof draft.classes]),record.subject,record.type,{text:record.sha256 ?? '—',hash:record.identity},record.status,{text:record.link ?? '—',href:record.href}]]} /></article>})}<a class="inline-link" href="/trust/claims/">{t('ledger-browse')}</a></div>}
    {section.kind === 'historical' && <p class="state-label" data-evidence-class="historical">{t(draft.classes.historical)}</p>}
    {section.kind === 'methodology' && <><p>{t('methodology-evidence')}</p><div class="action-group">{[['label-claims','/trust/claims/'],['label-provenance','/trust/provenance/'],['label-changelog','/trust/changelog/']].map(([label,href]) => <a class="inline-link" href={href}>{t(label!)}</a>)}</div></>}
    {section.kind === 'results' && <a class="inline-link" href={page.key === 'evidence' ? '/experiments/' : '/evidence/#experimental-results'}>{t(page.key === 'evidence' ? draft.labels.experiments : 'label-evidence')}</a>}
    {section.kind === 'availability' && <><p class="state-label">{t(draft.shared.availability)}</p><a class="inline-link" href="/evidence/#status">{t(draft.shared.evidence)}</a></>}
    {section.kind === 'agnostic' && <ul class="editorial-list">{['interop-agnostic-label','interop-agnostic-model','interop-agnostic-agent','interop-agnostic-cloud'].map(id => <li>{t(id)}</li>)}</ul>}
    {section.kind === 'intents' && <><ul class="editorial-list">{words(section).map(subject => <li><a class="inline-link" href={`mailto:${t('contact-hello')}?subject=${encodeURIComponent(subject)}`}>{subject}</a></li>)}</ul><p>{t('disclosure-report')}</p><a class="inline-link" href={`mailto:${t('contact-security')}`}>{t('contact-security')}</a></>}
    {section.kind === 'security' && <a class="inline-link" href="/trust/site-security/">{t('label-site-security')}</a>}
    {section.kind === 'contact' && <a class="action-link action-link--primary" href="/contact/">{t(page.key === 'products' ? draft.shared.pricing : page.key === 'solutions' ? draft.shared.partner : 'label-contact')}</a>}
    {!special.has(section.kind ?? '') && !['flow','milestones','cards','future','company','kpis'].includes(section.kind ?? '') && section.items && <ul class="editorial-list">{words(section).map(text => <li>{text}</li>)}</ul>}
  </Section>)}
</div></main>
