---
// Founder — Wireframes B, 06. Biography and motivation use founder-approved claims.
import Icon from '../Icon.astro';
import ContactCTA from '../ContactCTA.astro';
import LinkCard from '../LinkCard.astro';
import AboutSubnav from '../AboutSubnav.astro';
import Module from '../Module.astro';
import type { Copy } from '../copy';
interface Props { copy: Copy; route: { path: string }; title: string; [key: string]: unknown }
const { copy, route, title } = Astro.props;
const { t, href, paragraphs } = copy;
const headline = t('founder-headline');
const vision = paragraphs('vision-statement');
const credibility = ['brand-core-principle', 'brand-company-motto', 'founder-cred-methods', 'founder-cred-public', 'founder-cred-commitment'].map(t).filter(Boolean);
const focus = ['founder-focus-1', 'founder-focus-2', 'founder-focus-3', 'founder-focus-4'].map(t).filter(Boolean);
const contactHref = href('/contact/');
const gateHref = href('/gate-1/');
---
<main id="main" tabindex="-1" class="page-main">
  <div class="site-container page-stack">
    <AboutSubnav copy={copy} currentPath={route.path} />
    <Module id="founder-module" title={t('label-founder')!} plainBand numbered>
      <section class="founder-hero" aria-labelledby="founder-title">
        <span class="founder-hero__portrait" aria-hidden="true"><Icon name="user" size={120} /></span>
        <div class="founder-hero__copy">
          {headline && <p class="eyebrow">{t('label-founder')}</p>}
          <h1 class="page-title" id="founder-title">{headline ?? title}</h1>
          {t('about-founder-card') && <p class="lede">{t('about-founder-card')}</p>}
        </div>
      </section>
    </Module>

    {t('founder-why-title') && (
      <Module id="why-title" title={t('founder-why-title')!} numbered>
        <div class="box">
          <div class="prose">{vision.slice(0, 2).map(paragraph => <p>{paragraph}</p>)}</div>
        </div>
        <a class="inline-link" href="/vision/">{t('label-vision')}<Icon name="arrow-right" /></a>
      </Module>
    )}

    {t('founder-background-title') && (
      <Module id="background-title" title={t('founder-background-title')!} numbered>
        <div class="background-grid">
          <div class="box background-card">
            <Icon name="book" size={32} />
            {t('founder-background-card') && <h3 class="card-title">{t('founder-background-card')}</h3>}
            <p class="card-text">{t('about-founder-bio')}</p>
          </div>
          {t('founder-credibility') && (
            <div class="box credibility">
              <h3 class="credibility__title"><Icon name="shield-check" size={32} />{t('founder-credibility')}</h3>
              <ul class="bullet-list">{credibility.map(item => <li>{item}</li>)}</ul>
            </div>
          )}
        </div>
      </Module>
    )}

    {t('founder-building-title') && (
      <Module id="building-title" title={t('founder-building-title')!} numbered>
        <div class="box">
          <div class="prose">
            {vision[4] && <p>{vision[4]}</p>}
            <ul class="bullet-list">{focus.map(item => <li>{item}</li>)}</ul>
          </div>
        </div>
      </Module>
    )}

    {t('cta-get-in-touch') && (
      <ContactCTA id="founder-contact" variant="primary" title={t('cta-get-in-touch')!} text={t('founder-contact-body')} action={contactHref && t('label-contact') ? { href: contactHref, label: t('label-contact')! } : undefined} />
    )}

    <div class="link-cards">
      {t('founder-learn-title') && <LinkCard href="/about/company/" icon="home" title={t('founder-learn-title')!} text={t('founder-learn-body')} />}
      {t('founder-gate-title') && gateHref && <LinkCard href={gateHref} icon="sitemap" title={t('founder-gate-title')!} text={t('founder-gate-body')} />}
    </div>
  </div>
</main>
