---
// Landing hero: principle, motto, mission and calls to action. Company content lives at /about/company/.
import Icon from '../Icon.astro';
import type { Copy } from '../copy';
interface Props { copy: Copy; [key: string]: unknown }
const { copy } = Astro.props;
const { t, href } = copy;
const gateHref = href('/gate-1/');
const evidenceHref = href('/evidence/');
const aboutHref = href('/about/company/');
---
<main id="main" tabindex="-1" class="page-main page-main--home">
  <div class="site-container page-stack">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-hero__copy">
        <p class="eyebrow">{t('brand-core-principle')}</p>
        <h1 class="home-hero__title" id="home-title">{t('brand-company-motto')}</h1>
        <p class="lede">{t('brand-mission')}</p>
        <div class="action-group">
          {gateHref && t('cta-view-gate-1') && <a class="action-link action-link--primary" href={gateHref}>{t('cta-view-gate-1')}<Icon name="arrow-right" /></a>}
          {evidenceHref && t('cta-explore-evidence') && <a class="action-link action-link--secondary" href={evidenceHref}>{t('cta-explore-evidence')}</a>}
          {aboutHref && t('label-about') && <a class="action-link action-link--quiet" href={aboutHref}>{t('label-about')}</a>}
        </div>
      </div>
      <div class="home-hero__visual" aria-hidden="true">
        <div class="verify-module">
          <span class="verify-module__band"></span>
          <ul class="support-cells">
            {['supported', 'supported', 'supported', 'supported', 'supported'].map(state => (
              <li class={`support-cell support-cell--${state}`}><span class="support-cell__hex"><Icon name="check" /></span></li>
            ))}
          </ul>
          <span class="verify-module__bar"></span><span class="verify-module__bar verify-module__bar--short"></span>
          <span class="verify-module__beacon"></span>
        </div>
      </div>
    </section>
  </div>
</main>
