---
// Illustrative change intelligence: an incoming change reaches NorthCannon's persistent verified
// state, which calculates the blast radius; only then does the change propagate (red) to the
// decisions that depended on it. Inline SVG, no text, no script, no SMIL: all motion is CSS
// (`ci-` classes in pages.css). Labels are HTML overlaid on the stage (never SVG text). The
// graphic is labelled by its caption; while that claim is unapproved it is hidden from
// assistive technology so it is never unlabelled.
interface Props { alt?: string | undefined; note?: string | undefined; changeLabel?: string | undefined; stateLabel?: string | undefined; blastLabel?: string | undefined }
const { alt, note, changeLabel, stateLabel, blastLabel } = Astro.props;
// The three stage labels read as a sequence, so they render together or not at all.
const labels = changeLabel && stateLabel && blastLabel ? [changeLabel, stateLabel, blastLabel] : [];
const W = 180, H = 56, DY = 200;
interface Plate { id: string; x: number; y: number; hop?: 1 | 2 | 3; decision?: 'live' | 'steady'; source?: boolean }
const plates: Plate[] = ([
  { id: 'src', x: 60, y: 252, source: true },
  { id: 'c1a', x: 340, y: 60, hop: 1 }, { id: 'c1b', x: 340, y: 160, hop: 1 }, { id: 'c1c', x: 340, y: 400 },
  { id: 'c2a', x: 620, y: 40, hop: 2 }, { id: 'c2b', x: 620, y: 140, hop: 2 }, { id: 'c2c', x: 620, y: 330 }, { id: 'c2d', x: 620, y: 440 },
  { id: 'c3a', x: 900, y: 100, hop: 3, decision: 'live' }, { id: 'c3b', x: 900, y: 340, decision: 'steady' },
] as Plate[]).map(plate => ({ ...plate, y: plate.y + DY }));
const byId = new Map(plates.map(plate => [plate.id, plate]));
// [from, to, propagating hop]
const edges: Array<[string, string, 0 | 1 | 2 | 3]> = [
  ['src', 'c1a', 1], ['src', 'c1b', 1], ['c1a', 'c2a', 2], ['c1b', 'c2b', 2], ['c2a', 'c3a', 3],
  ['c1c', 'c2c', 0], ['c1c', 'c2d', 0], ['c2b', 'c3a', 0], ['c2c', 'c3b', 0],
];
const d = (from: string, to: string) => {
  const a = byId.get(from)!, b = byId.get(to)!;
  const x1 = a.x + W, y1 = a.y + H / 2, x2 = b.x, y2 = b.y + H / 2, mid = (x1 + x2) / 2;
  return `M${x1} ${y1} C${mid} ${y1} ${mid} ${y2} ${x2} ${y2}`;
};
// Stage above the graph: the incoming change and the persistent verified state.
const change = { x: 60, y: 44, w: 300, h: 72 };
const state = { x: 470, y: 36, w: 320, h: 88 };
const src = byId.get('src')!;
const inPath = `M${change.x + change.w} ${change.y + change.h / 2} L${state.x - 14} ${state.y + state.h / 2}`;
// Runs through the clear band above the graph and the gap left of the first column, so it crosses no plate.
const calcPath = `M${state.x + 90} ${state.y + state.h} C${state.x + 90} ${state.y + state.h + 106} ${src.x + W / 2} ${src.y - 252} ${src.x + W / 2} ${src.y - 14}`;
---
<figure class="ci-figure">
  <div class="ci-stage">
    <svg class="ci-svg" viewBox="0 0 1200 760" preserveAspectRatio="xMidYMid meet" focusable="false" role={alt ? 'img' : undefined} aria-labelledby={alt ? 'demo-graphic-alt' : undefined} aria-hidden={alt ? undefined : 'true'}>
      <path class="ci-edge ci-edge--stage" d={inPath} fill="none" />
      <path class="ci-edge ci-edge--stage" d={calcPath} fill="none" />
      <path class="ci-in" d={inPath} pathLength="1" fill="none" />
      <path class="ci-calc" d={calcPath} pathLength="1" fill="none" />
      <polygon class="ci-head ci-head--in" points={`${state.x - 14},${state.y + state.h / 2 - 8} ${state.x},${state.y + state.h / 2} ${state.x - 14},${state.y + state.h / 2 + 8}`} />
      <polygon class="ci-head ci-head--calc" points={`${src.x + W / 2 - 8},${src.y - 14} ${src.x + W / 2},${src.y} ${src.x + W / 2 + 8},${src.y - 14}`} />
      <rect class="ci-change" x={change.x} y={change.y} width={change.w} height={change.h} rx="10" />
      <circle class="ci-change-ring" cx={change.x + 30} cy={change.y + change.h / 2} r="12" fill="none" />
      <circle class="ci-change-dot" cx={change.x + 30} cy={change.y + change.h / 2} r="7" />
      <rect class="ci-state" x={state.x} y={state.y} width={state.w} height={state.h} rx="10" />
      <rect class="ci-state-glow" x={state.x - 6} y={state.y - 6} width={state.w + 12} height={state.h + 12} rx="14" fill="none" />
      <g class="ci-db">
        <ellipse cx={state.x + 34} cy={state.y + 28} rx="16" ry="6" />
        <path d={`M${state.x + 18} ${state.y + 28} v30 a16 6 0 0 0 32 0 v-30`} />
        <path d={`M${state.x + 18} ${state.y + 43} a16 6 0 0 0 32 0`} />
      </g>
      {edges.map(([from, to]) => <path class="ci-edge" d={d(from, to)} fill="none" />)}
      {edges.filter(edge => edge[2] > 0).map(([from, to, hop]) => <path class:list={['ci-pulse', `ci-pulse--h${hop}`]} d={d(from, to)} pathLength="1" fill="none" />)}
      {plates.map(plate => (
        <g class:list={['ci-plate-group', plate.source ? 'ci-source-group' : undefined]}>
          <rect class:list={['ci-plate', plate.source ? 'ci-plate--source' : plate.hop ? `ci-plate--h${plate.hop}` : 'ci-plate--still']} x={plate.x} y={plate.y} width={W} height={H} rx="8" />
          <rect class="ci-bar" x={plate.x + (plate.decision ? 48 : 16)} y={plate.y + 14} width={plate.decision ? 84 : 110} height="8" rx="4" />
          <rect class="ci-bar" x={plate.x + (plate.decision ? 48 : 16)} y={plate.y + 34} width={plate.decision ? 60 : 72} height="8" rx="4" />
          {plate.hop && <polygon class:list={['ci-fold', `ci-fold--h${plate.hop}`]} points={`${plate.x + W - 22},${plate.y} ${plate.x + W},${plate.y} ${plate.x + W},${plate.y + 22}`} />}
          {plate.decision === 'live' && <circle class="ci-beacon-ring" cx={plate.x + 26} cy={plate.y + H / 2} r="10" fill="none" />}
          {plate.decision && <circle class:list={['ci-beacon', plate.decision === 'live' ? 'ci-beacon--live' : 'ci-beacon--steady']} cx={plate.x + 26} cy={plate.y + H / 2} r="10" />}
        </g>
      ))}
    </svg>
    {labels.map((label, index) => <p class:list={['ci-label', `ci-label--${['change', 'state', 'blast'][index]}`]} aria-hidden="true">{label}</p>)}
  </div>
  {labels.length > 0 && <ol class="ci-steps">{labels.map(label => <li>{label}</li>)}</ol>}
  {alt && <figcaption class="ci-caption" id="demo-graphic-alt">{alt}</figcaption>}
  {note && <p class="disclosure-line disclosure-line--inline">{note}</p>}
</figure>
