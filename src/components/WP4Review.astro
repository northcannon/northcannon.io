---
import ResultsDashboard from './ResultsDashboard.astro';
import EvidenceOverview from './EvidenceOverview.astro';
import ChangeIntelligencePreview from './ChangeIntelligencePreview.astro';
import ContactPanel from './ContactPanel.astro';
import GateStatus from './GateStatus.astro';
import Document from '../layouts/Document.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import Container from './Container.astro';
import ActionLink from './ActionLink.astro';
import { loadGovernance } from '../governance/registry.mjs';
import { readRoutes, routeClaim, navigationClaimId, draftBanner, legacyLabels } from '../governance/routes.mjs';
interface Props { route: ReturnType<typeof readRoutes>[number]; review?: boolean }
const { route, review = true } = Astro.props;
const data = loadGovernance();
const routes = readRoutes(data.claims);
const text = (id: string): string => legacyLabels.has(id) ? id : routeClaim(data.claims, route, routes, id, { review });
const title = route.path === '/404.html' ? 'Page not found' : text(route.title_claim_or_label);
const demo = route.path === '/demo/';
const home = route.path === '/';
const items = routes.filter(r => r.nav && (review || r.publish)).sort((a, b) => Number(b.path === '/about/') - Number(a.path === '/about/')).map(r => ({ href: r.path, label: text(navigationClaimId(r)) }));
const aboutPages = routes.filter(r => ['/about/company/', '/about/founder/'].includes(r.path) && (review || r.publish));
const metricIds = ['label-experiment-status', 'label-evaluation-count', 'label-p95-latency', 'label-token-usage', 'label-average-context-size', 'label-failed-evaluations', 'label-abstention-rate', 'label-verification-rate', 'label-evidence-packet-count', 'label-last-evaluation-timestamp', 'label-version-identifiers', 'label-model-versions', 'label-reproducibility-status', 'label-independent-review-status'];
const bodyIds: Record<string, string[]> = {
  '/evidence/': data.methodology.flatMap((e: { claim_ids: string[] }) => e.claim_ids),
  '/vision/': ['vision-statement'], '/results/': ['status-gate1-preparation'],
  '/trust/': ['trust-index'], '/trust/status/': [data.status[0].claim_id],
  '/trust/disclosure/': ['disclosure-report'], '/trust/site-security/': ['site-static', 'site-csp'],
  '/about/': [],
  '/about/company/': [],
  '/about/mission/': ['brand-mission'],
  '/about/vision/': ['vision-statement'],
  '/about/founder/': ['about-founder-bio'],
};
---
<Document title={title} shell={false}>
  <SiteHeader items={items} currentPath={route.path} showStatus />
  {!demo && review && <Container><p class="eyebrow">{draftBanner}</p></Container>}
  <main id="main" tabindex="-1" class:list={[home ? 'home-main' : 'page-main', { 'demo-main': demo }]}>
    <Container narrow={demo || route.path === '/404.html'}>
      <div class:list={{ 'about-split': route.path === '/about/' }}>
      <div>
      {home ? <div class="hero"><div class="hero__copy">
        <p class="eyebrow">{text('brand-core-principle')}</p>
        <h1 class="hero__title">{text('brand-company')}</h1>
        <p class="hero__motto">{text('brand-company-motto')}</p>
        <p class="hero__mission">{text('brand-mission')}</p>
        <div class="action-group"><ActionLink href="/trust/status/">{text('label-status')}</ActionLink><ActionLink href="/evidence/" variant="secondary">{text('label-evidence')}</ActionLink></div>
        <p class="hero__mission">{text('patent-pending')}</p>
      </div><div class="hero-art" aria-hidden="true"><img src="/northcannon-mark.svg" width="280" height="188" alt="" /></div></div> : <>
        {demo ? <h1 class="page-title demo-title"><span>{text('label-demo')}</span><span class="demo-subtitle">Coming Soon</span></h1> : <h1 class:list={['page-title', { 'page-title--recovery': route.path === '/404.html', 'page-title--about': route.path.startsWith('/about/') }]}>{title}</h1>}
        {route.path.startsWith('/about/') && <ul class="about-navigation">{aboutPages.map(r => <li><a href={r.path} aria-current={route.path === r.path ? 'page' : undefined}>{text(r.title_claim_or_label)}</a></li>)}</ul>}
        {['/about/', '/about/company/'].includes(route.path) && <div class="company-sections">{[['Mission statement', 'brand-mission'], ['Company vision', 'vision-statement']].map(([heading, id]) => <section class="panel"><h2>{heading}</h2>{text(id!).split('\n\n').map(paragraph => <p class="hero__mission">{paragraph}</p>)}</section>)}</div>}
        {(bodyIds[route.path] ?? []).flatMap(id => text(id).split('\n\n').filter((_, index) => route.path !== '/about/company/' || [1, 2, 4].includes(index)).map(paragraph => <p class="hero__mission">{paragraph}</p>))}
        {route.path === '/evidence/' && <EvidenceOverview text={text} />}
        {route.path === '/results/' && <ResultsDashboard text={text} metricIds={metricIds} />}
        {route.path === '/404.html' && <div class="action-group"><ActionLink href="/">Return home</ActionLink></div>}
        {route.path === '/trust/status/' && <GateStatus text={text} />}
        {route.path === '/trust/' && <ul class="trust-paths">{routes.filter(r => r.path.startsWith('/trust/') && r.path !== '/trust/' && (review || r.publish)).map(r => <li class="panel"><a href={r.path}>{text(r.title_claim_or_label)}</a></li>)}</ul>}
        {['/early-access/', '/trust/disclosure/'].includes(route.path) && <p class="hero__mission"><a href={`mailto:${text(route.path === '/early-access/' ? 'contact-hello' : 'contact-security')}`}>{text(route.path === '/early-access/' ? 'contact-hello' : 'contact-security')}</a></p>}
      </>}
      </div>
      {home && <div class="home-sections"><p class="panel experiment-banner">{text('status-gate1-preparation')}</p><div class="capability-cards">{[['label-evidence', 'methodology-evidence'], ['label-provenance', 'brand-core-principle'], ['label-vision', 'brand-company-motto']].map(([heading, copy]) => <section class="panel"><h2>{text(heading!)}</h2><p>{text(copy!)}</p></section>)}</div><div class="home-cards">{[['/evidence/', 'label-evidence'], ['/results/', 'label-results'], ['/about/', 'label-about']].map(([href, id]) => <a class="panel destination-card" href={href}><h2>{text(id!)}</h2><span aria-hidden="true">↗</span></a>)}</div></div>}
      {route.path === '/about/' && review && <ChangeIntelligencePreview text={text} />}
      </div>
      {!demo && route.path !== '/404.html' && <ContactPanel text={text} />}
    </Container>
  </main>
  <SiteFooter />
</Document>
