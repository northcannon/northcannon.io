---
import Container from './Container.astro';
import { claim } from '../governance/claim';
const copy = {
  company: await claim('brand-company'),
  principle: await claim('brand-core-principle'),
};
---
<footer class="site-footer">
  <Container>
    <div class="site-footer__inner">
      <span>{copy.company}</span>
      <p>{copy.principle}</p>
    </div>
  </Container>
</footer>
