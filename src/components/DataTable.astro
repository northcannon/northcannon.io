---
type Cell = string | { text: string; href?: string | undefined; hash?: string | undefined };
import HashValue from './HashValue.astro';
interface Props { caption: string; columns: string[]; rows: Cell[][] }
const { caption, columns, rows } = Astro.props;
---
<div class="table-scroll" tabindex="0" role="region" aria-label={caption}><table class="data-table"><caption>{caption}</caption><thead><tr>{columns.map(col => <th scope="col">{col}</th>)}</tr></thead><tbody>{rows.map(row => <tr>{row.map((value,index) => <td><span class="data-table__label" aria-hidden="true">{columns[index]}</span>{typeof value === 'string' ? <span>{value}</span> : value.href ? <a class="inline-link" href={value.href}>{value.text}</a> : value.hash ? <HashValue value={value.text} identity={value.hash} /> : <span>{value.text}</span>}</td>)}</tr>)}</tbody></table></div>
