---
import Container from './Container.astro';
import { claim } from '../governance/claim';
const copy = {
  company: await claim('brand-company'),
  status: await claim('status-gate1-preparation'),
  preparation: await claim('label-preparation'),
};
interface Props {
  items?: ReadonlyArray<{ label: string; href: string }>;
  currentPath?: string;
  showStatus?: boolean;
}
const { items = [], currentPath = Astro.url.pathname, showStatus = false } = Astro.props;
const normalize = (path: string) => path.replace(/\/$/, '') || '/';
---
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <Container>
    <div class="site-header__inner">
      <a class="wordmark" href="/" aria-label={`${copy.company} home`}>
        <img src="/northcannon-mark.svg" width="54" height="36" alt="" />
        <span>{copy.company}</span>
      </a>
      {showStatus && <a class="header-status" href="/trust/status/" aria-label={copy.status}><span aria-hidden="true"></span>{copy.preparation}</a>}
      {items.length > 0 && (
        <nav aria-label="Primary">
          <ul class="navigation desktop-navigation">
            {items.map(item => (
              <li><a href={item.href} aria-current={normalize(currentPath) === normalize(item.href) ? 'page' : undefined}>{item.label}</a></li>
            ))}
          </ul>
          <details class="mobile-navigation">
            <summary>Menu</summary>
            <ul class="navigation">
              {items.map(item => (
                <li><a href={item.href} aria-current={normalize(currentPath) === normalize(item.href) ? 'page' : undefined}>{item.label}</a></li>
              ))}
            </ul>
          </details>
        </nav>
      )}
    </div>
  </Container>
</header>
