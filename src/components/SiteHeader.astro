---
import { loadGovernance } from '../governance/registry.mjs';
import { eligibleClaim } from '../governance/schema.mjs';
import { draftClaim } from '../governance/routes.mjs';
import Icon from './Icon.astro';
interface Props {
  company: string;
  items: ReadonlyArray<{ label: string; href: string; cta?: boolean | undefined; children?: ReadonlyArray<{ label: string; href: string }> }>;
  currentPath: string;
  review?: boolean | undefined;
}
const { company, items, currentPath, review = false } = Astro.props;
const { claims } = loadGovernance();
for (const text of [company, ...items.map(item => item.label)].filter(Boolean)) {
  const registered = claims.find(c => c.statement === text);
  if (!registered) throw new Error('Unregistered header copy');
  if (review) draftClaim(claims, registered.claim_id); else eligibleClaim(registered, registered.claim_id);
}
const current = (href: string) => href === currentPath ? 'page' : undefined;
---
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header"><div class="site-container site-header__inner">
  <a class="wordmark" href="/" aria-label={`${company} home`}><img src="/northcannon-mark.svg" width="36" height="24" alt="" /><span>{company}</span></a>
  {items.length > 0 && <nav aria-label="Primary" class="primary-nav">
    <ul class="navigation desktop-navigation">{items.map(item => <li><a class:list={{ 'nav-cta': item.cta }} href={item.href} aria-current={current(item.href)}>{item.label}</a></li>)}</ul>
    <details class="mobile-navigation"><summary><Icon name="menu" /><span>Menu</span></summary>
      <ul class="navigation">{items.map(item => <li><a class:list={{ 'nav-cta': item.cta }} href={item.href} aria-current={current(item.href)}>{item.label}</a></li>)}</ul>
    </details>
  </nav>}
</div></header>
