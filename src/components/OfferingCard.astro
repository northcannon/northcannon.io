---
import StateChip from './StateChip.astro';
interface Props { title?: string; body?: string | undefined; status?: string; variant?: string; tone?: 'planned' | 'implemented' | 'reached' | 'illustrative' | 'future' | 'inactive' | 'neutral' }
const { title, body, status, variant = 'standard', tone = 'planned' } = Astro.props;
---
<article class:list={['offering-card', `offering-card--${variant}`]}>
  {status && <p class="chip-row"><StateChip label={status} tone={tone} /></p>}
  {title && <h3>{title}</h3>}{body && <p>{body}</p>}<slot />
</article>
