---
import f from '../../content/concept-scenario.json';
import draft from '../../content/redesign.json';
interface Props { t: (id: string) => string; variant?: 'change' | 'substrate' | 'obligations' }
const { t, variant = 'change' } = Astro.props;
const nodes=f.nodes.slice(0,7);
---
<div class:list={['reference-console', `reference-console--${variant}`]}>
  <header class="reference-console__bar"><span class="reference-console__brand"><img src="/northcannon-mark.svg" alt="" width="22" height="22"/>{t(variant==='substrate'?'brand-company':f.labels.console)}</span><span class="reference-tag">{t(f.labels.illustrative)}</span></header>
  <p class="reference-console__truth">{t(f.labels.truth)}</p>
  {variant==='substrate' ? <>
    <ol class="reference-substrate-flow">{draft.loop.map(([label,question])=><li><span class="reference-symbol" aria-hidden="true">◇</span><strong>{t(label!)}</strong><span>{t(question!)}</span></li>)}</ol>
    <div class="reference-fabric"><h2>{t(f.labels.queue)}</h2><ul>{f.obligations.slice(0,4).map(o=><li><span class="reference-symbol" aria-hidden="true">◇</span>{t(o.status)}</li>)}</ul></div>
    <div class="reference-recovery"><span class="reference-symbol" aria-hidden="true">◇</span><p>{t(draft.shared.recovery)}</p></div>
    <div class="reference-models">{draft.deployments.map(d=><div><span class="reference-symbol" aria-hidden="true">◇</span><strong>{t(d.title)}</strong><small>{t(draft.labels.planned)}</small></div>)}</div>
  </> : <>
    <div class="reference-console__proposal"><div><span class="reference-kicker">{t(f.labels.proposal)}</span><h2>{t(f.identity.proposed)}</h2><p>{t(f.identity.scope)}</p></div><span class="reference-tag reference-tag--amber">{t(f.labels.withheld)}</span></div>
    <div class="reference-console__grid"><details class="reference-impact reference-console__panel"><summary><h3>{t(f.labels.graph)}</h3></summary><svg viewBox="0 0 820 570" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><g fill="none" stroke="#a77afa" stroke-width="2">{f.edges.map(e=>{const a=nodes.find(n=>n.id===e.source)!;const b=nodes.find(n=>n.id===e.target)!;return <path d={`M${a.x+210} ${a.y+40}H${a.x+235}V${b.y+40}H${b.x}`} stroke-dasharray={e.state==='admitted'?undefined:'6 5'}/>;})}</g>{nodes.map(n=><g><rect x={n.x} y={n.y} width="210" height="80" rx="8" fill={n.state==='CHANGED'?'#26183d':'#191821'} stroke="#a77afa"/><text x={n.x+105} y={n.y+32} text-anchor="middle" fill="#f5f2fc" font-size="13">{t(n.label)}</text><text x={n.x+105} y={n.y+56} text-anchor="middle" fill="#c6a0ff" font-size="11">{t(f.states[n.state as keyof typeof f.states])}</text></g>)}</svg><div class="reference-counts">{['changed','potential','gaps'].map(k=><span>{t(f.count_claims[k as keyof typeof f.count_claims])}</span>)}</div></details>
    <details class="reference-activity reference-console__panel"><summary><h3>{t(f.labels.queue)}</h3></summary><div class="reference-activity__list">{f.obligations.slice(0,4).map((o,i)=><div><span class="reference-avatar" aria-hidden="true">{['◇','◇','◇','◇'][i]}</span><p><strong>{t(f.nodes.find(n=>n.id===o.node)!.label)}</strong><small>{t(o.status)}</small></p><i aria-hidden="true"/></div>)}</div></details></div>
    <div class="reference-console__bottom"><details class="reference-console__panel"><summary><h3>{t(f.labels.timeline)}</h3></summary><ol>{f.lifecycle.slice(0,4).map(stage=><li>{t(stage.label)}</li>)}</ol></details><details class="reference-console__panel"><summary><h3>{t(f.labels.coverage)}</h3></summary><p>{t(f.labels['unknown-note'])}</p><span class="reference-tag reference-tag--amber">{t(f.count_claims.gaps)}</span></details></div>
  </>}
</div>
