---
// Decorative extruded hexagonal sheet. No scientific or product-state meaning.
interface Props { id: string }
const { id } = Astro.props;
const radius = 34;
const cells = Array.from({ length: 30 }, (_, col) => Array.from({ length: 9 }, (_, row) => {
  const cx = col * radius * 1.5 - 30;
  const cy = (row + (col % 2) / 2) * radius * Math.sqrt(3) - 180;
  const points = Array.from({ length: 6 }, (_, corner) => {
    const angle = corner * Math.PI / 3;
    const x = cx + radius * Math.cos(angle);
    const y = cy + radius * Math.sin(angle);
    return [x, 70 + y * .56 + 24 * Math.sin(x / 240) + 12 * Math.cos(y / 135)];
  });
  return { points, polygon: points.map(p => p.join(',')).join(' ') };
})).flat();
---
<svg class="reference-graphene" viewBox="0 0 1440 140" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <defs><linearGradient id={`${id}-light`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#d6baff"/><stop offset=".4" stop-color="#7950b2"/><stop offset=".7" stop-color="#ad83df"/><stop offset="1" stop-color="#482b75"/></linearGradient></defs>
  <g fill="none" stroke="#211631" stroke-width="1.3" transform="translate(0 10)">{cells.map(c => <polygon points={c.polygon}/>)}</g>
  <g stroke="#493564" stroke-width="1">{cells.map(c => c.points.slice(0,3).map(([x,y]) => <path d={`M${x} ${y}v10`}/>) )}</g>
  <g fill="#271832" fill-opacity=".12" stroke={`url(#${id}-light)`} stroke-width="1.1">{cells.map(c => <polygon points={c.polygon}/>)}</g>
  <g fill="#b69bd7">{cells.map(c => c.points.slice(0,2).map(([cx,cy]) => <circle cx={cx} cy={cy} r="1.65"/>))}</g>
</svg>
