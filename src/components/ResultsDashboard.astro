---
interface Props { text: (id: string) => string; metricIds: string[] }
const { text, metricIds } = Astro.props;
const arms = ['Treatment', 'Baseline A', 'Baseline B', 'Arm R⁺'];
---
<div class="dashboard-shell">
  <aside class="dashboard-rail panel">
    <p class="dashboard-kicker">{text('label-results')}</p>
    <nav aria-label="Comparison arms"><ul>{arms.map((arm, i) => <li><a href={`#arm-${i}`}>{arm}<span aria-hidden="true">↗</span></a></li>)}</ul></nav>
    <div class="rail-status"><span class="status-label">{text('label-preparation')}</span><p>{text('label-independent-review-status')}</p><strong>{text('label-null')}</strong></div>
  </aside>
  <div class="dashboard-workspace">
    <div class="dashboard-summary">{metricIds.map(id => <section class="panel stat-card"><h2>{text(id)}</h2><span class="stat-rule" aria-hidden="true"></span></section>)}</div>
    <div class="result-arms">{arms.map((arm, i) => <section class="panel arm-panel" id={`arm-${i}`}>
      <header class="arm-header"><h2>{arm}</h2><span class="status-label">{text('label-preparation')}</span></header>
      <p class="arm-empty">{text('status-gate1-preparation')}</p>
    </section>)}</div>
  </div>
</div>
