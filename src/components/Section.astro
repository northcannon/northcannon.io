---
interface Props { id: string; title: string; intro?: string; instrument?: boolean }
const { id, title, intro, instrument = false } = Astro.props;
---
<section id={id} aria-labelledby={`${id}-heading`} class:list={['product-section', { 'product-section--instrument': instrument }]}>
  <h2 id={`${id}-heading`}>{title}</h2>{intro && <p class="section-lede">{intro}</p>}<slot />
</section>
