---
interface Props { name: string; alt: string; bio: string; quote: string; note: string }
const { name, alt, bio, quote, note } = Astro.props;
---
<div class="founder-profile"><picture><source type="image/webp" srcset="/founder/max-brooks-480.webp 480w, /founder/max-brooks-960.webp 960w" sizes="(max-width: 767px) 128px, 192px" /><img src="/founder/max-brooks-480.png" width="480" height="480" loading="lazy" alt={alt} /></picture><div><p>{name}</p><p>{bio}</p><blockquote>{quote}</blockquote><p class="section-lede">{note}</p></div></div>
